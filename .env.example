# URL of your Home Assistant instance (no trailing slash)
HA_URL=http://192.168.1.x:8123

# Entity ID of the smart switch in Home Assistant
# Find it in HA → Developer Tools → States
HA_ENTITY_ID=switch.my_smart_plug

# Optional: long-lived access token (leave empty if HA has no auth)
HA_TOKEN=

# Display name shown on the status page (defaults to HA friendly_name)
PLUG_NAME=Smart Plug

# Port exposed on the host machine
HOST_PORT=8080
